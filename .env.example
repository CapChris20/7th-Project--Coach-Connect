# Firebase Configuration (Get from Firebase Console > Project Settings)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Supabase (Get from Supabase Dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Services
EXPO_PUBLIC_CLAUDE_API_KEY=sk-ant-api03-your_claude_key
EXPO_PUBLIC_OPENAI_API_KEY=sk-your_openai_key

# Exercise Database (Get from RapidAPI.com - ExerciseDB)
EXPO_PUBLIC_EXERCISEDB_API_KEY=your_rapidapi_key

# Stripe (Get from Stripe Dashboard > Developers > API Keys)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
