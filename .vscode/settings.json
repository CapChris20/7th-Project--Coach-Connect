{
  "typescript.preferences.importModuleSpecifier": "relative",
  "javascript.preferences.importModuleSpecifier": "relative",
  "typescript.suggest.paths": true,
  "javascript.suggest.paths": true,
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "javascript.preferences.includePackageJsonAutoImports": "on",

  // Sidebar stays lean: only day-to-day app folders + a few root configs.
  // Files are still on disk — Open file / search / terminal still find them.
  // To unhide something: set it to false (or delete the line) and save.
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/.expo": true,
    "**/.metro": true,
    "**/.firebase": true,
    "**/.yarn": true,

    ".cursor": true,
    ".github": true,
    ".maestro": true,
    ".vscode": true,

    "docs": true,
    "load-tests": true,
    "scripts": true,
    "test": true,
    "tests": true,
    "metro": true,
    "config": true,
    "public": true,

    ".dockerignore": true,
    ".env.maestro": true,
    ".eslintrc.json": true,
    ".firebaserc": true,
    ".gcloudignore": true,
    ".npmrc": true,
    "Dockerfile": true,
    "package-lock.json": true,
    "babel.config.js": true,
    "metro.config.js": true,
    "jsconfig.json": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/.expo": true,
    "**/.metro": true,
    "**/build": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.git": true,
    "ios/Pods": true,
    "docs": true,
    "load-tests": true
  }
}
