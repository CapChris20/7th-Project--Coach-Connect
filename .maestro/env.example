# Copy to .env.maestro in project root, then: source .env.maestro && npm run test:maestro
# Do not commit .env.maestro (it is gitignored).

export MAESTRO_CLIENT_EMAIL="client-test@example.com"
export MAESTRO_CLIENT_PASSWORD="your-password"
export MAESTRO_TRAINER_EMAIL="trainer-test@example.com"
export MAESTRO_TRAINER_PASSWORD="your-password"

