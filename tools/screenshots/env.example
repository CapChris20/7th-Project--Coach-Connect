# Copy values into your shell (do not commit real values).
# export $(grep -v '^#' env.local | xargs)  — keep env.local gitignored.

export SCREENSHOT_CLIENT_EMAIL="cc-screenshot-client@example.com"
export SCREENSHOT_CLIENT_PASSWORD="replace-me"
export SCREENSHOT_TRAINER_EMAIL="cc-screenshot-trainer@example.com"
export SCREENSHOT_TRAINER_PASSWORD="replace-me"

# Firebase Admin (one of these)
# export FIREBASE_SERVICE_ACCOUNT_PATH="/absolute/path/to/serviceAccount.json"
# export GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/serviceAccount.json"
# export FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

export SCREENSHOT_WEB_URL="http://127.0.0.1:8081"
export SCREENSHOT_SCENARIO="with-food"

# App web boot (repo .env) also needs EXPO_PUBLIC_FIREBASE_* and
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID for Expo web.
