rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isConversationParticipant(conversationId) {
      return request.auth != null
        && conversationId is string
        && conversationId.size() > 4
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // CRM link: requester is trainer for client userId
    function isLinkedTrainer(userId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/trainer_clients/$(request.auth.uid)/clients/$(userId));
    }
    // Trainers collection (searchable trainer profiles)
    match /trainers/{trainerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == trainerId;
    }

    // Client → trainer coaching payments (server writes only)
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.client_id || request.auth.uid == resource.data.trainer_id);
      allow write: if false;
    }

    // Users collection
    match /users/{userId} {
      // SECURITY: user docs are private by default.
      // - Owner can read their own doc.
      // - Trainer can read their client's doc (CRM link).
      // - Client can read their trainer's doc (same CRM link, inverse direction).
      // - Either party can read the other's profile if they already have a client–trainer
      //   conversation doc (getOrCreateConversation uses conv_{clientId}_{trainerId}).
      //   This lets "Add as client" load the counterparty user doc before CRM is written.
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId) ||
        exists(/databases/$(database)/documents/trainer_clients/$(userId)/clients/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/conversations/$('conv_' + userId + '_' + request.auth.uid)) ||
        exists(/databases/$(database)/documents/conversations/$('conv_' + request.auth.uid + '_' + userId))
      );
      
      // Allow list queries for trainer search (needed for where('role', '==', 'trainer') queries)
      allow list: if request.auth != null;

      // Writes: owner profile fields; trainer may set only trainerId on a client doc (marketplace accept).
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['trainerId', 'role', 'linked', 'subscription', 'stripeAccountId', 'stripeStatus', 'subscriptionTier']);
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['trainerId', 'role', 'linked', 'subscription', 'stripeAccountId', 'stripeStatus', 'subscriptionTier']);
    }

    // Current workout plan (users/{uid}/workoutPlan/current) — client owns; linked trainer can read
    match /users/{userId}/workoutPlan/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
    }

    // AI Chat Coach sessions (users/{uid}/aiChats/{sessionId}) — user can read/write own
    // Per-message docs live in messages/ subcollection (saveCoachMessages.js).
    match /users/{userId}/aiChats/{sessionId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;

      match /messages/{messageId} {
        allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Macro targets + history (AI Coach day-14 recalibration)
    match /users/{userId}/macroTargets/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/macroHistory/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Denormalized unread message badge (users/{uid}/unreadCount/index)
    match /users/{userId}/unreadCount/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Progress photos (users/{clientId}/progressPhotos/*) — client or linked trainer can read/write
    match /users/{userId}/progressPhotos/{photoId} {
      allow read, list: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
      allow update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
    }

    // AI workout plans collection (users/{clientId}/workoutPlans/*) — client or linked trainer can read/write
    match /users/{userId}/workoutPlans/{planId} {
      allow read, list: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
      allow update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
    }

    // Optional: global workoutPlans collection (workoutPlans/*) — client or their linked trainer can read
    match /workoutPlans/{planId} {
      allow read, list: if request.auth != null && (
        resource.data.clientId == request.auth.uid ||
        exists(/databases/$(database)/documents/trainer_clients/$(request.auth.uid)/clients/$(resource.data.clientId))
      );
      // Writes should be done by the owner (client) or server-side; keep tight.
      allow create, update, delete: if request.auth != null && request.auth.uid == request.resource.data.clientId;
    }

    // Trainer-authored manual workout plan templates (trainer-owned; not client-visible at this path)
    match /trainer_workout_plans/{planId} {
      allow read, list: if request.auth != null && resource.data.trainerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.trainerId == request.auth.uid;
    }
    
    // Conversations - only participants can read/update/delete; creators must include themselves
    match /conversations/{conversationId} {
      // Only participants can read or update a conversation
      allow read, update: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      
      // Allow list queries for conversations where user is participant
      allow list: if request.auth != null;

      // Only authenticated users can create — and they must include themselves as participant
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      // Only participants can delete
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;
    }

    // Voice AI sessions (per-user subcollection path used by VoiceAIHomeScreen/VoiceAIChatScreen)
    // Path:
    // - /conversations/{userId}/sessions/{sessionId}
    // - /conversations/{userId}/sessions/{sessionId}/messages/{messageId}
    match /conversations/{userId}/sessions/{sessionId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;

      match /messages/{messageId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Messages (top-level collection) — participants of the conversation only
    match /messages/{messageId} {
      allow read: if request.auth != null
        && resource.data.conversationId is string
        && isConversationParticipant(resource.data.conversationId);

      allow list: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.conversationId is string
        && isConversationParticipant(request.resource.data.conversationId);

      allow update: if request.auth != null
        && resource.data.conversationId is string
        && isConversationParticipant(resource.data.conversationId)
        && (
          request.auth.uid == resource.data.senderId ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']) &&
            request.resource.data.read == true
          ) ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'responseTimestamp']) &&
            (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected')
          ) ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']) &&
            (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected' || request.resource.data.status == 'pending')
          ) ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['responseTimestamp']) &&
            request.resource.data.responseTimestamp != null
          )
        );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.senderId
        && resource.data.conversationId is string
        && isConversationParticipant(resource.data.conversationId);
    }
    
    // Workouts (legacy - daily workouts)
    match /workouts/{workoutId} {
      // Allow read if user owns the workout
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Allow list queries (for getTodaysWorkouts) - user can query their own workouts
      allow list: if request.auth != null;
      
      // Allow create if userId matches authenticated user
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      
      // Allow update/delete if user owns the workout
      allow update, delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Workout Templates - NEW
    match /workoutTemplates/{templateId} {
      // Read: user owns the template
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Allow list queries - user can query their own templates
      // Note: For queries with where('userId', '==', userId), Firestore validates
      // that only documents matching the query are returned, and the read rule
      // above ensures only the user's own templates are accessible
      allow list: if request.auth != null;
      
      // Create: userId must match authenticated user
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      
      // Update/Delete: user owns the template
      allow update, delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Active Workouts - NEW
    match /activeWorkouts/{activeWorkoutId} {
      // Read: user owns the active workout
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Allow list queries - user can query their own active workouts
      allow list: if request.auth != null;
      
      // Create: userId must match authenticated user
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      
      // Update/Delete: user owns the active workout
      allow update, delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Completed Workouts - NEW
    match /completedWorkouts/{completedWorkoutId} {
      // Read: user owns the completed workout
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Allow list queries - user can query their own completed workouts
      allow list: if request.auth != null;
      
      // Create: userId must match authenticated user (only system creates these)
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      
      // Users can't update/delete completed workouts (read-only history)
      allow update, delete: if false;
    }
    
    // Saved Workout Plans (legacy top-level collection)
    match /savedWorkoutPlans/{planId} {
      allow read, list: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/trainer_clients/$(request.auth.uid)/clients/$(resource.data.userId))
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Nutrition logs
    match /nutrition_logs/{logId} {
      // Allow read if user owns the log OR trainer is reading a client's logs (for CRM)
      allow read: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/trainer_clients/$(request.auth.uid)/clients/$(resource.data.user_id)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
        )
      );
      
      // Allow list queries - user can query their own logs; trainer can query a client's logs
      allow list: if request.auth != null;
      
      // Allow create if user_id matches authenticated user
      allow create: if request.auth != null && 
        request.resource.data.user_id == request.auth.uid;
      
      // Allow update/delete if user owns the log
      allow update, delete: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
    }
    
    // Nutrition goals - FIXED (document ID is userId)
    match /nutrition_goals/{goalId} {
      // Allow read if user owns the goal OR trainer is reading a client's goals (for CRM)
      allow read: if request.auth != null && (
        goalId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/trainer_clients/$(request.auth.uid)/clients/$(goalId)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
        )
      );
      
      // Allow list queries - user can query their own goals
      allow list: if request.auth != null;
      
      // Allow create if goalId matches authenticated user
      allow create: if request.auth != null && goalId == request.auth.uid;
      
      // Allow update/delete if user owns the goal
      allow update, delete: if request.auth != null && goalId == request.auth.uid;
    }
    
    // Trainer reviews
    match /trainerReviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.resource.data.clientId == request.auth.uid;
      allow update, delete: if request.auth != null && 
        resource.data.clientId == request.auth.uid;
    }
    
    // App errors (for error logging)
    match /app_errors/{errorId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    
    // Daily quote - public read access for all authenticated users, allow write for app to update
    match /dailyQuote/{quoteId} {
      allow read: if request.auth != null;
      // Only admin can write (via custom claim)
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }
    
    // Trainer-Client Links - FLAT collection (easy to see in Firebase Console)
    // One document per trainer-client relationship. Query: where('trainerId', '==', trainerUid)
    match /trainer_client_links/{linkId} {
      // Create: Admin SDK only (acceptClientRequest callable)
      allow create: if false;
      allow read, list: if request.auth != null && (
        resource.data.trainerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow update, delete: if request.auth != null && resource.data.trainerId == request.auth.uid;
    }
    
   // Trainer-Client Relationships - main CRM store
    match /trainer_clients/{trainerUid}/clients/{clientUid} {

      // Create: Admin SDK only (acceptClientRequest / linkClientWithTrainerCode callables)
      allow create: if false;
      // Update/Delete: trainer can manage their own clients
      allow update, delete: if request.auth != null
        && request.auth.uid == trainerUid;

      // Trainer or client can read this CRM doc
      allow read: if request.auth != null && (
        request.auth.uid == trainerUid ||
        request.auth.uid == clientUid
      );

      // Trainer or client can list (for queries)
      allow list: if request.auth != null && (
        request.auth.uid == trainerUid ||
        request.auth.uid == clientUid
      );

      // Workouts subcollection - NEW
      match /workouts/{workoutId} {
        // Read: Trainer or client can read workouts
        allow read: if (
          request.auth != null && (
            request.auth.uid == trainerUid ||
            request.auth.uid == clientUid
          )
        );
        
        // Allow list queries for trainer or client
        allow list: if (
          request.auth != null && (
            request.auth.uid == trainerUid ||
            request.auth.uid == clientUid
          )
        );
        
        // Create, Update, Delete: Only trainer can manage workouts
        allow create, update, delete: if request.auth != null && request.auth.uid == trainerUid;
      }
      
      // Progress subcollection - NEW
      match /progress/{progressId} {
        // Read: Trainer or client can read progress entries
        allow read: if (
          request.auth != null && (
            request.auth.uid == trainerUid ||
            request.auth.uid == clientUid
          )
        );
        
        // Allow list queries for trainer or client
        allow list: if (
          request.auth != null && (
            request.auth.uid == trainerUid ||
            request.auth.uid == clientUid
          )
        );
        
        // Create: Trainer can create, client can create (self-reported weight)
        allow create: if (
          request.auth != null && (
            request.auth.uid == trainerUid ||
            (request.auth.uid == clientUid && request.resource.data.loggedBy == clientUid)
          )
        );
        
        // Update, Delete: Only trainer can modify progress entries
        allow update, delete: if request.auth != null && request.auth.uid == trainerUid;
      }
      
      // Notes subcollection (trainer notes + client-added notes from Notes & Files)
      match /notes/{noteId} {
        allow read, list: if request.auth != null && (
          request.auth.uid == trainerUid ||
          request.auth.uid == clientUid
        );
        // Trainer can manage; client can create (when adding from plus-button modal)
        allow create: if request.auth != null && (
          request.auth.uid == trainerUid ||
          request.auth.uid == clientUid
        );
        allow update, delete: if request.auth != null && request.auth.uid == trainerUid;
      }
      // Files subcollection (client-added photos, videos, PDFs from Notes & Files)
      match /files/{fileId} {
        allow read, list: if request.auth != null && (
          request.auth.uid == trainerUid ||
          request.auth.uid == clientUid
        );
        allow create: if request.auth != null && (
          request.auth.uid == trainerUid ||
          request.auth.uid == clientUid
        );
        allow update, delete: if request.auth != null && request.auth.uid == trainerUid;
      }
    }

    // Trainer CRM calendar — scheduled sessions (trainer_clients/{trainerUid}/sessions)
    // Written by useSessions / SessionFormScreen; one doc per session across all clients.
    match /trainer_clients/{trainerUid}/sessions/{sessionId} {
      // Trainer can read/list their calendar.
      // Client can read sessions that belong to them (resource.data.clientId == authed uid).
      // Also allow via CRM link if present.
      allow read: if request.auth != null && (
        request.auth.uid == trainerUid ||
        (resource != null && resource.data.clientId == request.auth.uid) ||
        exists(/databases/$(database)/documents/trainer_clients/$(trainerUid)/clients/$(request.auth.uid))
      );

      // Allow list queries; per-document reads are still enforced by the allow read rule above.
      allow list: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == trainerUid
        && request.resource.data.clientId is string
        && exists(/databases/$(database)/documents/trainer_clients/$(trainerUid)/clients/$(request.resource.data.clientId));

      // Update:
      // - trainer can edit any session fields for their calendar
      // - client can only respond (status) to their own session
      allow update: if request.auth != null && (
        (
          request.auth.uid == trainerUid
          && request.resource.data.clientId is string
          && exists(/databases/$(database)/documents/trainer_clients/$(trainerUid)/clients/$(request.resource.data.clientId))
        ) ||
        (
          exists(/databases/$(database)/documents/trainer_clients/$(trainerUid)/clients/$(request.auth.uid))
          && resource != null
          && resource.data.clientId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'respondedAt', 'updatedAt'])
          && (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined')
        )
      );

      allow delete: if request.auth != null && request.auth.uid == trainerUid;
    }
    
    // Legacy Clients Collection (for backward compatibility)
    match /clients/{clientId} {
      // Create: Only trainers can create client records (simplified - just check trainerId matches auth)
      allow create: if (
        request.auth != null &&
        request.resource.data.trainerId == request.auth.uid
      );
      
      // Read: Trainer who owns the client, or the client themselves
      allow read: if (
        request.auth != null && (
          resource.data.trainerId == request.auth.uid ||
          request.auth.uid == clientId
        )
      );
      
      // Allow list queries for trainers to query their clients
      allow list: if request.auth != null;
      
      // Update: Only trainer who owns the client can update
      allow update: if (
        request.auth != null &&
        resource.data.trainerId == request.auth.uid
      );
      
      // Delete: Only trainer who owns the client can delete
      allow delete: if (
        request.auth != null &&
        resource.data.trainerId == request.auth.uid
      );
    }
    
    // Workouts (trainer-client specific) - NEW
    match /workouts/{trainerUid}/clients/{clientUid}/workouts/{workoutId} {
      // Read: Trainer or client can read workouts
      allow read: if (
        request.auth != null && (
        request.auth.uid == trainerUid ||
        request.auth.uid == clientUid
        )
      );
      
      // List: Trainer or client can list workouts
      allow list: if (
        request.auth != null && (
        request.auth.uid == trainerUid ||
        request.auth.uid == clientUid
        )
      );
      
      // Create, Update, Delete: Only trainer can manage workouts
      allow create, update, delete: if request.auth != null && request.auth.uid == trainerUid;
    }
    
    // Notifications - Admin SDK only (createNotification Cloud Function)
    match /notifications/{notificationId} {
      // Create: Server Admin SDK only — client app uses createNotification callable
      allow create: if false;
      
      // Read: Only recipient can read their notifications
      allow read: if (
        request.auth != null && (
          request.auth.uid == resource.data.trainerUid || 
          request.auth.uid == resource.data.clientUid
        )
      );
      
      // Allow list queries for trainers to query their notifications
      allow list: if request.auth != null;
      
      // Update: Only recipient can update (mark as read)
      allow update: if (
        request.auth != null && (
          request.auth.uid == resource.data.trainerUid || 
          request.auth.uid == resource.data.clientUid
        )
      );
      
      // Delete: Only recipient can delete
      allow delete: if (
        request.auth != null && (
          request.auth.uid == resource.data.trainerUid || 
          request.auth.uid == resource.data.clientUid
        )
      );
    }
    
    // Events (for logging) - FIXED
    match /events/{eventId} {
      // Create: Authenticated users can create events
      allow create: if request.auth != null;
      
      // Allow list queries for authenticated users (needed for queries)
      allow list: if request.auth != null;
      
      // Read: Allow read if user is trainer or client mentioned in event
      allow read: if (
        request.auth != null && (
          request.auth.uid == resource.data.trainerUid ||
          request.auth.uid == resource.data.clientUid ||
          request.auth.uid == resource.data.userId
        )
      );
      
      // Update, Delete: No one can modify events (immutable)
      allow update, delete: if false;
    }
    
    // Errors (for debugging) - NEW
    match /errors/{errorId} {
      // Create: System can create error logs
      allow create: if request.auth != null;
      
      // Read: System/admin only
      allow read: if false;
      
      // Update, Delete: No one can modify errors (immutable)
      allow update, delete: if false;
    }
    
    // Restaurant nutrition cache (structured macros from web + LLM extraction)
    match /restaurantNutrition/{docId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Foods collection (for food search) - NEW
    match /foods/{foodId} {
      // Read: All authenticated users can read foods (public food database)
      allow read: if request.auth != null;
      
      // Allow list queries for food search
      allow list: if request.auth != null;
      
      // Create/Update: Authenticated users can save food data
      allow create, update: if request.auth != null;
      // Delete: Not allowed
      allow delete: if false;
    }
    
    // User food logs subcollection - NEW
    match /users/{userId}/foodLogs/{logId} {
      // Read: User can read their own food logs
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow list queries - user can query their own logs
      allow list: if request.auth != null && request.auth.uid == userId;
      
      // Create: User can create their own food logs
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Update/Delete: User can modify their own food logs
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // User daily logs subcollection (My Dashboard check-ins: sleep, water, workouts, etc.)
    match /users/{userId}/dailyLogs/{dateId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
      allow list: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Weekly summaries subcollection (AI-generated weekly reports, read-only to clients/trainers)
    match /users/{userId}/weeklySummaries/{weekId} {
      // Read/list: client themselves or their linked trainer (CRM)
      allow read, list: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
      // No client-side writes; Cloud Functions use admin SDK and bypass these rules
    }

    // User nutrition subcollection (food logs, macros, etc.)
    match /users/{userId}/nutrition/{itemId} {
      allow read, list: if request.auth != null && (
        request.auth.uid == userId ||
        isLinkedTrainer(userId)
      );
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Trainer-created documents (users/{trainerId}/documents) — trainer CRUD; client can read if shared
    match /users/{userId}/documents/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource != null && resource.data.sharedWith != null && request.auth.uid in resource.data.sharedWith)
      );
      allow list: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // User notes & files — client and trainer can add; grouped by addedBy (client | trainer)
    // Trainer access: client doc may use trainerId OR only CRM link at trainer_clients/{t}/clients/{client}
    match /users/{userId}/notes_and_files/{itemId} {
      allow read, list: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(userId)).data.trainerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(userId)).data.trainer_id == request.auth.uid ||
        exists(/databases/$(database)/documents/trainer_clients/$(request.auth.uid)/clients/$(userId))
      );
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(userId)).data.trainerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(userId)).data.trainer_id == request.auth.uid ||
        exists(/databases/$(database)/documents/trainer_clients/$(request.auth.uid)/clients/$(userId))
      );
      allow update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        (
          resource.data.addedBy == 'trainer' &&
          (
            get(/databases/$(database)/documents/users/$(userId)).data.trainerId == request.auth.uid ||
            get(/databases/$(database)/documents/users/$(userId)).data.trainer_id == request.auth.uid ||
            exists(/databases/$(database)/documents/trainer_clients/$(request.auth.uid)/clients/$(userId))
          )
        )
      );
    }

    // User daily tracking subcollection (water, etc.) - NEW
    match /users/{userId}/daily_tracking/{dateId} {
      // Read: User can read their own daily tracking
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow list queries - user can query their own tracking
      allow list: if request.auth != null && request.auth.uid == userId;
      
      // Create/Update: User can create/update their own daily tracking
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Delete: User can delete their own daily tracking
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Server-tracked API usage counters (read-only for clients)
    match /users/{userId}/usage/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // AI Coach actions (audit log) - NEW
    match /users/{userId}/aiCoachActions/{actionId} {
      // Read: User can read their own AI Coach audit trail
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow list queries - user can query their own AI Coach actions
      allow list: if request.auth != null && request.auth.uid == userId;
      
      // Create: User can create their own AI Coach action logs (via AI Coach tool executor)
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Update/Delete: No writes to audit trail after creation (immutable)
      allow update, delete: if false;
    }

    // Sleep logs - NEW
    match /users/{userId}/sleep_logs/{dateId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Water logs - NEW
    match /users/{userId}/water_logs/{dateId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Step logs - NEW
    match /users/{userId}/step_logs/{dateId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Energy logs - NEW
    match /users/{userId}/energy_logs/{dateId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Mood logs - NEW
    match /users/{userId}/mood_logs/{dateId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Workout ratings - NEW
    match /users/{userId}/workout_ratings/{dateId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Daily metrics (aggregated dashboard data) - NEW
    match /users/{userId}/dailyMetrics/{dateId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}

