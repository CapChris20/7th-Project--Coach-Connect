{
  "name": "coachconnect-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npx expo start --dev-client",
    "start:dev": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios --device \"iPhone 16 Plus\"",
    "build:dev": "eas build --profile development --platform ios",
    "web": "npx expo start --web",
    "server": "NODE_ENV=development AI_COACH_ENFORCE_LIMITS=0 node server/index.js",
    "test": "node ./scripts/runJestWithLog.js --runInBand",
    "test:jest": "jest --runInBand",
    "test:jest:log": "node ./scripts/runJestWithLog.js",
    "test:coach-web-search": "node ./scripts/testCoachWebSearchRouting.js",
    "test:ai-coach-audit-fixes": "node ./scripts/testAiCoachAuditFixes.js",
    "test:daily-metrics": "node ./scripts/testDailyMetricsService.js",
    "test:food-search": "node ./scripts/testFoodSearchAccuracy.js",
    "test:food-search:smoke": "node ./scripts/testFoodSearchAccuracy.js --smoke --verbose",
    "test:security": "node ./scripts/testSecurityFixes.js",
    "test:component-imports": "node ./scripts/checkComponentImports.js",
    "fix:imports": "node ./scripts/fixRelativeImports.js && node ./scripts/fixAllBrokenImports.js --fix && node ./scripts/restoreAssetExtensions.js && node ./scripts/verifyRelativeImports.js",
    "verify:imports": "node ./scripts/verifyRelativeImports.js",
    "test:a11y-core": "node ./scripts/checkCoreAccessibility.js",
    "test:firestore-indexes": "node ./scripts/verifyFirestoreIndexes.js",
    "test:quality": "npm run test:daily-metrics && npm run test:coach-web-search && npm run test:ai-coach-audit-fixes && npm run test:a11y-core && npm run test:firestore-indexes",
    "test:ci": "npm run test:quality && npm run lint:ci",
    "test:coverage": "node ./scripts/runJestWithLog.js --runInBand --coverage",
    "test:jest-log": "node ./scripts/runJestWithLog.js",
    "test:coach-web-search:live": "node ./scripts/testCoachWebSearchLive.js",
    "api:verify": "bash ./scripts/verifyProductionApi.sh",
    "api:sync-env": "bash ./scripts/syncCloudRunEnv.sh",
    "api:deploy": "bash ./server/deploy.sh",
    "prerelease": "bash ./scripts/preReleaseCheck.sh",
    "build:production": "bash ./scripts/preReleaseCheck.sh && eas build --profile production",
    "inspect:trainer-prices": "node ./scripts/inspectTrainerMarketplacePrices.js",
    "gen:errors": "node ./scripts/generateErrorList.js",
    "gen:onboarding-icons": "node ./scripts/generateOnboardingIconRegistry.mjs",
    "print:google-oauth": "node ./scripts/printGoogleOAuthClientIds.js",
    "restore:user": "node ./scripts/restoreUserByEmail.js",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "lint:ci": "eslint \"src/**/*.{js,jsx}\" --max-warnings 10000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.9.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react-native": "^1.0.11",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tradle/react-native-http": "^2.0.1",
    "assert": "^2.1.0",
    "axios": "^1.6.2",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "crypto-browserify": "^3.12.1",
    "dotenv": "^17.3.1",
    "events": "^3.3.0",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.12",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.10",
    "express-rate-limit": "^8.2.1",
    "firebase": "^10.7.1",
    "firebase-admin": "^13.7.0",
    "fs": "^0.0.1-security",
    "https-browserify": "^1.0.0",
    "lottie-react-native": "~7.3.1",
    "lucide-react-native": "^1.14.0",
    "maath": "^0.10.8",
    "multer": "^2.1.0",
    "nodemailer": "^6.10.1",
    "openai": "^4.104.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.48.2",
    "react-native": "0.81.5",
    "react-native-config": "^1.5.10",
    "react-native-crypto": "^2.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "react-native-worklets-core": "^1.6.3",
    "react-native-youtube-iframe": "^2.4.1",
    "stream-browserify": "^3.0.0",
    "three": "^0.166.0",
    "url": "^0.11.4",
    "uuid": "^13.0.0",
    "victory-native": "^37.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/eslint-parser": "^7.28.6",
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@testing-library/react-native": "^12.9.0",
    "@types/react": "~19.1.10",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/__tests__"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest.setup.js"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(expo|expo-.*|@expo|@expo/.*|react-native|@react-native|@react-navigation)/)"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^expo/virtual/env$": "<rootDir>/src/__tests__/mocks/expoVirtualEnv.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/__tests__/**"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "expo-av",
          "react-native-crypto"
        ]
      }
    }
  }
}
