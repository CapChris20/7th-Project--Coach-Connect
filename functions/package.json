{
  "name": "coachconnect-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for CoachConnect - Realtime API WebSocket Proxy",
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "verify:weekly": "node scripts/verifyWeeklySummaryJob.js"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "cors": "^2.8.5",
    "moment-timezone": "^0.5.45"
  },
  "private": true
}






