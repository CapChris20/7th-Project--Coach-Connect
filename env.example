# Firebase Configuration for Anatrox AI
# Copy this file to .env and fill in your actual Firebase project credentials

# Get these values from your Firebase Console > Project Settings > General > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=anatrox-auth.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=anatrox-auth
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=anatrox-auth.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Optional: Supabase Configuration (if you want to use Supabase alongside Firebase)
# EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: OpenAI API Key for AI features
# EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic API Key for Claude AI features
# EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key_here
